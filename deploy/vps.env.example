# Copy to .env.vps at the repository root. Never commit that file.
APP_DOMAIN=chess.example.com
ACME_EMAIL=you@example.com
# Generate EACH value separately with: openssl rand -hex 32
# Use hex for POSTGRES_PASSWORD so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
# Tag every release with its commit ID or release name. Keep the previous image.
APP_VERSION=local

# Required for club registration and account recovery before launch.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Google sign-in. Configure its callback using your final HTTPS domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional site usage and signup analytics (Umami Cloud or self-hosted).
# Use the HTTPS script URL and Website ID shown in your Umami website settings.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
