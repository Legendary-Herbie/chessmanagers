# Copy to .env.backup at the repository root and chmod 600.
# This is sourced by Bash: use single-quoted literal values, no commands.
RESTIC_REPOSITORY='s3:https://YOUR-STORAGE-ENDPOINT/YOUR-BUCKET/onechessclub'
RESTIC_PASSWORD='CHANGE_ME_SEPARATE_LONG_BACKUP_PASSWORD'
AWS_ACCESS_KEY_ID='CHANGE_ME'
AWS_SECRET_ACCESS_KEY='CHANGE_ME'
AWS_DEFAULT_REGION='us-east-1'
# Optional monitoring heartbeat URL. Backup sends success, or URL/fail on failure.
BACKUP_HEARTBEAT_URL=''
