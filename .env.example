
# Leave empty in development to use Vite's same-origin /api/v1 proxy.
# Set an absolute URL only when the frontend and API are deployed separately.
VITE_API_URL=
VITE_APP_NAME=1chessclub
# Optional Umami analytics for a separately hosted frontend build.
# The domain prevents local and staging visits from entering production reports.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_DOMAIN=
