{
  "name": "chess-club-ratings",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "dev": "concurrently \"npm run start\" \"npm run server:dev\"",
    "dev:all": "concurrently \"npm run start\" \"npm run server\"",
    "build": "vite build",
    "build:prod": "npm run build && cd server && npm install --omit=dev",
    "start": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:all": "vitest run && npm --prefix server test",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.20.0",
    "@tanstack/react-query-devtools": "^5.20.0",
    "@tanstack/react-virtual": "^3.13.18",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.0.1",
    "@vitest/ui": "^3.0.1",
    "glob": "^13.0.6",
    "jsdom": "^26.0.0",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^9.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-router": "^7.14.2",
    "react-router-dom": "^7.14.2",
    "uid": "^2.0.2",
    "vite": "^7.2.4",
    "vitest": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "concurrently": "^9.2.1",
    "dom-accessibility-api": "^0.7.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "uuid": "^14.0.0"
  }
}
