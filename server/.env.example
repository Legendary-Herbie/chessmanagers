// Example environment variables for development. Copy this file to .env and fill in the values.
PORT=// Port to run the server on
NODE_ENV=// Environment (development or production)
JWT_SECRET=// Secret key for signing JWTs
JWT_EXPIRY_DAYS=// Number of days until JWTs expire
CORS_ORIGIN=  // Allowed origin for CORS (e.g. http://localhost:3000)
FRONTEND_URL_PROD=// URL of the frontend in production
FRONTEND_URL_DEV=// URL of the frontend in development
SERVE_FRONTEND=// Whether the server should serve the frontend (true or false)
MAX_CLUBS_PER_USER=// Maximum number of clubs a user can create
REFRESH_TOKEN_EXPIRY_DAYS=// Number of days until refresh tokens expire
DB_TYPE=// Type of database (e.g. postgres, mysql, sqlite)
DATABASE_URL=// Database connection URL
SMTP_HOST=// SMTP server host
SMTP_PORT=// SMTP server port
SMTP_SECURE=// Whether to use secure connection for SMTP (true or false)
SMTP_USER=// SMTP username for sending emails
SMTP_PASS=// SMTP password for sending emails
SMTP_FROM=// Email address to use as the sender for outgoing emails
