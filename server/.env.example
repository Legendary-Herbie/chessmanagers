# Example environment variables for development. Copy this file to .env and fill in the values.
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
EMAIL_VERIFICATION_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_MINUTES=30
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SAME_SITE=lax
SERVE_FRONTEND=false
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chessmanagers
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/chessmanagers_test
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
