{
    "name": "chess-club-server",
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "main": "index.js",
    "dependencies": {
        "@echecs/swiss": "^3.1.3",
        "bcryptjs": "^3.0.3",
        "body-parser": "^1.20.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "csv-stringify": "^6.8.3",
        "dotenv": "^17.2.3",
        "express": "^4.19.2",
        "express-rate-limit": "^8.3.2",
        "fs-extra": "^11.2.0",
        "google-auth-library": "^11.0.2",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.2.0",
        "node-pg-migrate": "^8.0.4",
        "nodemailer": "^9.0.6",
        "pg": "^8.18.0",
        "sanitize-html": "^2.17.7",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "nodemon": "^3.1.14",
        "supertest": "^6.3.4",
        "vitest": "^3.0.1"
    },
    "scripts": {
        "start": "node index.js",
        "dev": "nodemon index.js",
        "test": "vitest run",
        "test:ui": "vitest run --ui",
        "lint": "eslint .",
        "migrate:create": "node-pg-migrate create --migrations-dir src/database/migrations --envPath .env",
        "migrate:up": "node-pg-migrate up --migrations-dir src/database/migrations --migrations-table pgmigrations --envPath .env",
        "migrate:down": "node-pg-migrate down --migrations-dir src/database/migrations --migrations-table pgmigrations --envPath .env",
        "migrate:redo": "node-pg-migrate redo --migrations-dir src/database/migrations --migrations-table pgmigrations --envPath .env"
    }
}
